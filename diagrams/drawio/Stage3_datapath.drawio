<mxCell id="access" value="Memory access: X and O (first residual) / X holding R and FFN scratch (second residual)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#1678be;fontColor=#1678be;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="260" y="480" width="950" height="65" as="geometry"/></mxCell>
<mxCell id="note" value="Residual 1: R[t,j] = QACT(X[t,j] + O[t,j]). Residual 2: next X[t,j] = QACT(R[t,j] + F[t,j]).&lt;br&gt;Reuse the Stage 2 addition block with both inputs in ACT format. Read both operands before replacing the left value.&lt;br&gt;Same controller, different source descriptors. No normalization or dot product inside residual addition." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="1440" height="85" as="geometry"/></mxCell>
