<mxCell id="edge_capture" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#1678be;fontColor=#1678be;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.47368421052631576;entryX=0;entryY=0.5;" edge="1" parent="1" source="input" target="regs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
