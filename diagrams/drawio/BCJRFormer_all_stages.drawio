<mxCell id="edge_wwait_next" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="wwait" target="next"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
