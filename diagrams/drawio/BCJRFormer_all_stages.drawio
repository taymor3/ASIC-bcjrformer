<mxCell id="title" value="Softmax controller" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1440" height="35" as="geometry"/></mxCell>
<mxCell id="s0" value="Idle" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="90" y="85" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="s1" value="Check query&lt;br&gt;mask" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="320" y="85" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="s2" value="Find max" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="550" y="85" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="s3" value="Exp / store&lt;br&gt;/&lt;br&gt;sum loop" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="780" y="85" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="s4" value="Run&lt;br&gt;reciprocal" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="1010" y="85" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="s5" value="Init j = 0" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="1240" y="85" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="s6" value="Prepare&lt;br&gt;normal&lt;br&gt;or uniform&lt;br&gt;p" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="1240" y="270" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="s7" value="Write p" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="1010" y="270" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="s8" value="Next entry" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="780" y="270" width="105" height="105" as="geometry"/></mxCell>
