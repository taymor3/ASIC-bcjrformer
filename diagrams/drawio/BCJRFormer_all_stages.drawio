<mxCell id="s1" value="Request" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="320" y="85" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="s2" value="Wait&lt;br&gt;response" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="550" y="85" width="105" height="105" as="geometry"/></mxCell>
