<mxCell id="title" value="Stage 2 index and address logic — controlled by the Stage 2 FSM" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1440" height="35" as="geometry"/></mxCell>
<mxCell id="frame" value="Indices and addresses" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="190" y="75" width="1090" height="505" as="geometry"/></mxCell>
<mxCell id="ctrl" value="Stage 2 controller — owns these index registers" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="220" y="125" width="1030" height="50" as="geometry"/></mxCell>
<mxCell id="command" value="Start / command" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="125" width="140" height="50" as="geometry"/></mxCell>
<mxCell id="done" value="Done / error" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="1320" y="125" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="input" value="Initialize / advance&lt;br&gt;after write done" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="285" width="145" height="90" as="geometry"/></mxCell>
<mxCell id="counter" value="Integer registers&lt;br&gt;m, n, j&lt;br&gt;Xptr, Pptr, Eptr" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#75509e;fontColor=#75509e;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="260" y="285" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="compare" value="Compare last index&lt;br&gt;j = D−1&lt;br&gt;n = N−1; m = M−1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#438b35;fontColor=#438b35;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="585" y="255" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="update" value="Add / select&lt;br&gt;increment or wrap&lt;br&gt;next index / pointer" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#438b35;fontColor=#438b35;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="870" y="265" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="output" value="Read / write&lt;br&gt;addresses" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#1678be;fontColor=#1678be;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="1320" y="285" width="160" height="90" as="geometry"/></mxCell>
<mxCell id="mapping" value="Addresses: Xbase + tD + j; Pbase + nD + j; Ebase + mD + j, with t = mN + n.&lt;br&gt;These formulas explain the layout. Hardware advances pointers; no runtime multiply, divide or modulo." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="260" y="490" width="985" height="70" as="geometry"/></mxCell>
<mxCell id="note" value="j selects one feature; n selects a position; m selects a read slot. D = features/token, N = positions/read, M = read slots.&lt;br&gt;Xptr advances each value. Pptr wraps after N × D values; Eptr returns to the current read row for each new position.&lt;br&gt;These registers belong to the Stage 2 controller, not an independently scheduled child. All widths are sized for the allowed dimensions." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="1440" height="85" as="geometry"/></mxCell>
