<mxCell id="rule2" value="Stay in the same state while stalled.&lt;br&gt;Capture a result once, on acceptance.&lt;br&gt;Advance indices only after write done.&lt;br&gt;Error: drain accepted work, report&lt;br&gt;failure; Stage 3 must not start." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1130" y="505" width="350" height="145" as="geometry"/></mxCell>
