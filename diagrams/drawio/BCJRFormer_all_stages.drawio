<mxCell id="b2" value="Add exp values&lt;br&gt;RECIP black box" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#438b35;fontColor=#438b35;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="778.3333333333334" y="290" width="220" height="95" as="geometry"/></mxCell>
<mxCell id="b3" value="Multiply by 1/sum&lt;br&gt;Convert / write" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#438b35;fontColor=#438b35;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="1055" y="290" width="220" height="95" as="geometry"/></mxCell>
