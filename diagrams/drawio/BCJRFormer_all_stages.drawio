<mxCell id="input" value="Command operands&lt;br&gt;value and P or E" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#1678be;fontColor=#1678be;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="285" width="145" height="95" as="geometry"/></mxCell>
<mxCell id="regs" value="Operand registers&lt;br&gt;A and B" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#75509e;fontColor=#75509e;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="255" y="280" width="195" height="90" as="geometry"/></mxCell>
<mxCell id="align" value="Sign extend&lt;br&gt;Align fractions" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#438b35;fontColor=#438b35;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="535" y="280" width="165" height="90" as="geometry"/></mxCell>
<mxCell id="sum" value="Add&lt;br&gt;wide sum" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#438b35;fontColor=#438b35;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="780" y="285" width="135" height="70" as="geometry"/></mxCell>
<mxCell id="convert" value="Round / saturate&lt;br&gt;Stage 2 detail 6" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#438b35;fontColor=#438b35;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="1040" y="280" width="205" height="90" as="geometry"/></mxCell>
<mxCell id="output" value="ACT result&lt;br&gt;round / sat flags" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#1678be;fontColor=#1678be;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="1320" y="285" width="160" height="90" as="geometry"/></mxCell>
<mxCell id="math" value="a = QACT(e + P[n,j])      then      X⁽⁰⁾ = QACT(a + E[m,j])&lt;br&gt;QACT = round to nearest, ties to even, then clip to the stored activation range." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="250" y="450" width="990" height="80" as="geometry"/></mxCell>
<mxCell id="note" value="A is the current ACT value; B is a trained parameter. Fraction alignment uses exact shifts and extra bits, not early rounding.&lt;br&gt;Each addition returns one converted result; the stage controller owns memory reads and writes. Addition FSM: Stage 2 detail 5.&lt;br&gt;Saturation is recorded but does not stop the frame. No multiplication, division, normalization or dot product is needed here." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="1440" height="85" as="geometry"/></mxCell>
<mxCell id="edge_start" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="command" target="ctrl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
