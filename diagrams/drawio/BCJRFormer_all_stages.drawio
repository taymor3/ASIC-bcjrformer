<mxCell id="note" value="Only one accepted transaction is outstanding. Hold request address/data until accepted; never reissue after acceptance.&lt;br&gt;Read done carries data; write done means the bank confirms commitment, not simply that the request was accepted.&lt;br&gt;Arbitration selects the one active owner. Banks are external to this view." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="1440" height="85" as="geometry"/></mxCell>
