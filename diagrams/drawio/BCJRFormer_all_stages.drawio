<mxCell id="b2" value="Multiply Sₙ / Cₙ&lt;br&gt;Convert / store" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#438b35;fontColor=#438b35;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="778.3333333333334" y="290" width="220" height="95" as="geometry"/></mxCell>
<mxCell id="b3" value="Frame-valid check&lt;br&gt;Release output" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#438b35;fontColor=#438b35;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="1055" y="290" width="220" height="95" as="geometry"/></mxCell>
<mxCell id="input" value="Read logits z&lt;br&gt;and padding mask" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#1678be;fontColor=#1678be;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="145" height="75" as="geometry"/></mxCell>
<mxCell id="output" value="Final logits [N]&lt;br&gt;only if frame valid" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#1678be;fontColor=#1678be;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="1320" y="300" width="160" height="75" as="geometry"/></mxCell>
<mxCell id="access" value="Memory access: read logits[M,N] / padding mask[M,N] / buffered final logits[N]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#1678be;fontColor=#1678be;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="260" y="480" width="950" height="65" as="geometry"/></mxCell>
<mxCell id="note" value="For each position n: v[m,n] = NOT mask[m,n]; Sₙ = Σₘ v[m,n]·z[m,n]; Cₙ = Σₘ v[m,n].&lt;br&gt;If Cₙ &gt; 0: logit[n] = QACT(Sₙ × RECIP(Cₙ)). Count and sum always use the SAME valid reads for that position.&lt;br&gt;If any Cₙ = 0: invalidate the whole output frame, report EMPTY_POSITION+n, then return to idle without reset." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="1440" height="85" as="geometry"/></mxCell>
