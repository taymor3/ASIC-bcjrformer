</root></mxGraphModel></diagram>
<diagram id="add-fsm" name="Addition FSM"><mxGraphModel dx="1500" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="720"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Addition controller — circular FSM" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1440" height="35" as="geometry"/></mxCell>
<mxCell id="idle" value="Idle /&lt;br&gt;capture" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="80" y="220" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="align" value="Align&lt;br&gt;operands" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="310" y="220" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="issue" value="Issue add" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="540" y="220" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="wait" value="Wait add" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="770" y="220" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="convert" value="Convert" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="done" value="Done /&lt;br&gt;hold result" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="1230" y="220" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="details" value="Idle accepts one pair A,B. Issue add waits for request acceptance; Wait add captures one wide sum.&lt;br&gt;Convert registers the rounded / saturated ACT result and flags. Done holds them unchanged until accepted.&lt;br&gt;If the adder is combinational, Issue / Wait can later be merged; keep this interface independent of latency." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="180" y="490" width="1130" height="85" as="geometry"/></mxCell>
<mxCell id="note" value="This child never writes memory and never advances m, n or j. It reports completion to the Stage 2 controller.&lt;br&gt;The controller is reused for the P addition and the E addition. Reset initializes it; ordinary rounding/saturation is not a fatal error." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="1440" height="85" as="geometry"/></mxCell>
<mxCell id="edge_idle_align" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="idle" target="align"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_align_issue" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="align" target="issue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_issue_wait" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="issue" target="wait"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_wait_convert" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="wait" target="convert"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_convert_done" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="convert" target="done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_return" value="result accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.49523809523809526;exitY=1;entryX=0.49523809523809526;entryY=1;dashed=1;" edge="1" parent="1" source="done" target="idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1282" y="420"/><mxPoint x="132" y="420"/></Array></mxGeometry></mxCell>
</root></mxGraphModel></diagram>
<diagram id="conversion" name="Round and saturate"><mxGraphModel dx="1500" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="720"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Round and saturate — bit operations inside the addition block" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1440" height="35" as="geometry"/></mxCell>
<mxCell id="frame" value="Round and saturate" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="190" y="75" width="1090" height="505" as="geometry"/></mxCell>
<mxCell id="ctrl" value="Controlled by the Addition FSM (Stage 2 detail 5)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="220" y="125" width="1030" height="50" as="geometry"/></mxCell>
<mxCell id="command" value="Control inputs" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="125" width="140" height="50" as="geometry"/></mxCell>
<mxCell id="done" value="Status capture" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="1320" y="125" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="input" value="Wide signed&lt;br&gt;sum v" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#1678be;fontColor=#1678be;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="145" height="75" as="geometry"/></mxCell>
<mxCell id="split" value="Shift / bit select&lt;br&gt;q = v &gt;&gt; k&lt;br&gt;guard, sticky, q bit 0" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#438b35;fontColor=#438b35;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="240" y="280" width="200" height="105" as="geometry"/></mxCell>
<mxCell id="logic" value="OR and AND&lt;br&gt;inc = guard AND&lt;br&gt;(sticky OR q bit 0)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#438b35;fontColor=#438b35;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="520" y="290" width="230" height="85" as="geometry"/></mxCell>
<mxCell id="round" value="Add&lt;br&gt;q + inc" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#438b35;fontColor=#438b35;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="825" y="290" width="145" height="85" as="geometry"/></mxCell>
<mxCell id="clip" value="Compare / select&lt;br&gt;min or max or&lt;br&gt;rounded value" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#438b35;fontColor=#438b35;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="1040" y="280" width="195" height="105" as="geometry"/></mxCell>
<mxCell id="output" value="ACT result&lt;br&gt;flags" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#1678be;fontColor=#1678be;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="1320" y="300" width="160" height="75" as="geometry"/></mxCell>
<mxCell id="explain" value="k = fractional bits to remove. Guard is the highest removed bit; sticky is OR of the other removed bits.&lt;br&gt;Use an arithmetic right shift (signed floor). The increment rule handles negative values and ties to even.&lt;br&gt;If k = 0: no bits are removed and inc = 0. Keep the carry bit before the min/max comparisons." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="240" y="470" width="1000" height="90" as="geometry"/></mxCell>
<mxCell id="note" value="The Addition controller supplies the controls here; this conversion path does not need a separate controller.&lt;br&gt;Clip only after rounding. Keep rounded-changed and saturated flags separate; log one result at the accepted write.&lt;br&gt;If the incoming format has fewer fractional bits than ACT, sign extend and shift left exactly instead of discarding bits." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="1440" height="85" as="geometry"/></mxCell>
<mxCell id="edge_start" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="command" target="ctrl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_done" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="ctrl" target="done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_split_input" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#1678be;fontColor=#1678be;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5066666666666667;entryX=0;entryY=0.5047619047619047;" edge="1" parent="1" source="input" target="split"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_split_logic" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#1678be;fontColor=#1678be;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.42857142857142855;entryX=0;entryY=0.49411764705882355;" edge="1" parent="1" source="split" target="logic"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_logic_inc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#1678be;fontColor=#1678be;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.49411764705882355;entryX=0;entryY=0.7058823529411765;" edge="1" parent="1" source="logic" target="round"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_base_round" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#1678be;fontColor=#1678be;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.55;exitY=1;entryX=0.4482758620689655;entryY=1;" edge="1" parent="1" source="split" target="round"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="445"/><mxPoint x="890" y="445"/></Array></mxGeometry></mxCell>
<mxCell id="edge_rounded_clip" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#1678be;fontColor=#1678be;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.49411764705882355;entryX=0;entryY=0.49523809523809526;" edge="1" parent="1" source="round" target="clip"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_clip_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#1678be;fontColor=#1678be;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.49523809523809526;entryX=0;entryY=0.5066666666666667;" edge="1" parent="1" source="clip" target="output"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_ctrl_clip" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.8932038834951457;exitY=1;entryX=0.5128205128205128;entryY=0;dashed=1;" edge="1" parent="1" source="ctrl" target="clip"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
</root></mxGraphModel></diagram>
<diagram id="error" name="Error handling"><mxGraphModel dx="1500" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="720"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Stage 2 failure path — applies from any active state" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1440" height="35" as="geometry"/></mxCell>
<mxCell id="failure" value="Failure&lt;br&gt;detected" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="190" y="230" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="stop" value="Stop new&lt;br&gt;requests" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="435" y="230" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="drain" value="Drain&lt;br&gt;accepted&lt;br&gt;work" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="680" y="230" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="report" value="Hold failed&lt;br&gt;completion" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="925" y="230" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="locked" value="Wait for&lt;br&gt;reset" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;strokeWidth=2;rounded=0;shape=ellipse;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="1170" y="230" width="105" height="105" as="geometry"/></mxCell>
<mxCell id="detail" value="Failure = memory / protocol error or overflow outside a declared temporary format.&lt;br&gt;Keep handling accepted responses; do not request more reads, additions or writes.&lt;br&gt;Report failure after outstanding work is drained; hold until the frame controller accepts it.&lt;br&gt;Partial X values are invalid. Stage 3 is blocked. A new frame requires reset and reload under the fatal-error policy." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="160" y="430" width="1190" height="125" as="geometry"/></mxCell>
<mxCell id="note" value="Normal rounding or saturation is not a failure; record the flags and continue.&lt;br&gt;For a child failure, the addition result/error handshake still completes so the Stage 2 controller can drain and report it." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="1440" height="85" as="geometry"/></mxCell>
<mxCell id="edge_failure_stop" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="failure" target="stop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_stop_drain" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="stop" target="drain"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_drain_report" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="drain" target="report"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge_report_locked" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="report" target="locked"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
