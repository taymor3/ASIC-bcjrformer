<mxCell id="access" value="Memory access: mask_base + mN+n / logit_base + mN+n; increment by N as m advances" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#1678be;fontColor=#1678be;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="260" y="480" width="950" height="65" as="geometry"/></mxCell>
<mxCell id="note" value="A valid position enables BOTH sum and count. A padded position enables neither; never count only wholly unpadded reads.&lt;br&gt;Sₙ starts at zero with enough signed width for M logits. Cₙ starts at zero and must represent 0..M exactly.&lt;br&gt;No feature quantization applies to count or addresses. The controller advances m after the selected contribution completes." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="1440" height="85" as="geometry"/></mxCell>
