<mxCell id="input" value="Encoder output&lt;br&gt;X⁽ᴷ⁾ [L,D]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#1678be;fontColor=#1678be;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="145" height="75" as="geometry"/></mxCell>
