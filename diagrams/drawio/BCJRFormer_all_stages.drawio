<mxCell id="edge_loop" value="more values: j, then n, then m" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#c62828;fontColor=#c62828;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.49523809523809526;exitY=0;entryX=0.49523809523809526;entryY=1;dashed=1;" edge="1" parent="1" source="next" target="xreq"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="592" y="470"/><mxPoint x="35" y="470"/><mxPoint x="35" y="255"/><mxPoint x="592" y="255"/></Array></mxGeometry></mxCell>
