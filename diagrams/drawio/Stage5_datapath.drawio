<mxCell id="access" value="Memory access: read logits[M,N] / padding mask[M,N] / buffered final logits[N]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#1678be;fontColor=#1678be;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="260" y="480" width="950" height="65" as="geometry"/></mxCell>
<mxCell id="note" value="For each position n: v[m,n] = NOT mask[m,n]; Sₙ = Σₘ v[m,n]·z[m,n]; Cₙ = Σₘ v[m,n].&lt;br&gt;If Cₙ &gt; 0: logit[n] = QACT(Sₙ × RECIP(Cₙ)). Count and sum always use the SAME valid reads for that position.&lt;br&gt;If any Cₙ = 0: invalidate the whole output frame, report EMPTY_POSITION+n, then return to idle without reset." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#374151;fontColor=#374151;strokeWidth=2;rounded=0;strokeColor=none;fillColor=none;fontColor=#263442;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="1440" height="85" as="geometry"/></mxCell>
