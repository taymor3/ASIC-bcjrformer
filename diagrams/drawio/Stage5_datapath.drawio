<mxCell id="access" value="Memory access: final buffered logits[N]; invalid frames have no readout permission" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fillColor=#ffffff;strokeColor=#1678be;fontColor=#1678be;strokeWidth=2;rounded=0;" vertex="1" parent="1"><mxGeometry x="260" y="480" width="950" height="65" as="geometry"/></mxCell>
